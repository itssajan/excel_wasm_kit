{
  "name": "@milojs/excel-kit",
  "version": "0.1.1",
  "description": "Fast, low-memory Excel reader (xlsx, xlsm, xlsb, xls, ods) for browsers and Node, in WebAssembly",
  "keywords": [
    "excel",
    "xlsx",
    "xls",
    "xlsb",
    "ods",
    "spreadsheet",
    "reader",
    "parser",
    "wasm",
    "webassembly",
    "streaming"
  ],
  "author": "Sajan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itssajan/excel_wasm_kit.git"
  },
  "homepage": "https://itssajan.github.io/excel_wasm_kit",
  "bugs": "https://github.com/itssajan/excel_wasm_kit/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "pkg/nodejs/nodejs_index.js",
  "module": "pkg/web/web_index.js",
  "types": "pkg/web/web_index.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/web/web_index.d.ts",
      "node": {
        "import": "./js/node.mjs",
        "require": "./pkg/nodejs/nodejs_index.js"
      },
      "default": "./pkg/web/web_index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "pkg/nodejs/",
    "pkg/web/",
    "js/"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "wasm-pack build --target nodejs --out-dir ./pkg/nodejs --out-name nodejs_index --release  --scope milojs",
    "build:web": "wasm-pack build --target web --out-dir ./pkg/web --out-name web_index --release --scope milojs",
    "prebuild": "rm -rf ./pkg",
    "postbuild": "rm ./pkg/**/.gitignore && node scripts/postbuild.cjs",
    "test": "cargo test && node --test tests/workbook.test.mjs && npm run test:types",
    "test:types": "npx -y -p typescript tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --lib es2022 tests/types/consumer.mts"
  }
}
