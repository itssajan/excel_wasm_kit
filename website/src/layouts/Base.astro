---
import "../styles/global.css";
import { GITHUB, NPM, VERSION, url } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** full-height app page: no legal footer */
  app?: boolean;
  /** keep the page out of search results */
  noindex?: boolean;
  /** extra schema.org structured data for this page */
  jsonLd?: object;
}
const {
  title,
  description = "Fast, low-memory Excel reader for browsers and Node.js, in Rust + WebAssembly.",
  app = false,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url("/og.png"), Astro.site);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "@kuramajs/excel",
    alternateName: "Kurama Excel",
    url: new URL(url("/"), Astro.site),
    description: "Fast, low-memory Excel reader for browsers and Node.js, in Rust + WebAssembly.",
  },
  ...(jsonLd ? [jsonLd] : []),
];

const pages = [
  { href: url("/playground"), label: "Playground", key: "playground" },
  { href: url("/benchmarks"), label: "Benchmarks", key: "benchmarks" },
  { href: url("/docs"), label: "Docs", key: "docs" },
];
// Google Analytics measurement ID, set at build time (CI only, so dev visits aren't tracked)
const gaId = import.meta.env.PUBLIC_GA_ID;
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, "").replace(/^\/|\/$/g, "") || "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1311" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="@kuramajs/excel" />
    <meta property="og:locale" content="en" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kurama the nine-tailed fox, next to the text: Read huge Excel files with 10× less memory" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    {structuredData.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // set the theme before first paint
      const saved = localStorage.getItem("theme");
      if (saved === "dark" || (!saved && matchMedia("(prefers-color-scheme: dark)").matches))
        document.documentElement.classList.add("dark");
    </script>
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          {/* Google's exact snippet with the ID inline: define:vars wraps it in a function, which hides
              gtag from window and stops Search Console verifying ownership via Analytics */}
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}');`}
          />
        </>
      )
    }
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a href={url("/")} class="logo" aria-label="@kuramajs/excel home">
          <img class="mark" src={url("/brand/kurama.svg")} alt="" width="34" height="34" />
          <span><span class="scope">@kuramajs/</span>excel</span>
        </a>
        <nav class="main" id="nav" aria-label="Main">
          {pages.map((p) => <a href={p.href} class:list={{ active: current === p.key }} aria-current={current === p.key ? "page" : undefined}>{p.label}</a>)}
        </nav>
        <div class="spacer"></div>
        <div class="actions">
        <span class="pill">v{VERSION}</span>
        <a class="iconbtn" href={NPM} title="npm" aria-label="npm package">npm</a>
        <a class="iconbtn" href={GITHUB} title="GitHub" aria-label="GitHub repository">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.040 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        </a>
        <button class="iconbtn menubtn" id="menu" aria-label="Menu" aria-expanded="false" aria-controls="nav">☰</button>
        <button class="iconbtn" id="theme" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="tabsbar">
      <div class="wrap">
        <span class="arrows" aria-hidden="true">◂ ▸</span>
        <a href={url("/")} class:list={{ on: current === "home" }}>Home</a>
        {pages.map((p) => <a href={p.href} class:list={{ on: current === p.key }}>{p.label}</a>)}
        <span class="plus" aria-hidden="true">+</span>
      </div>
    </footer>
    {
      !app && (
        <footer class="legal">
          <div class="wrap">
            <span>MIT licensed</span>
            <a href="https://github.com/tafia/calamine">Built on calamine</a>
            <a href={GITHUB}>GitHub</a>
            <a href={NPM}>npm</a>
            <a href={url("/troubleshooting")}>Troubleshooting</a>
          </div>
        </footer>
      )
    }

    <script>
      document.getElementById("theme")!.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", dark ? "dark" : "light");
      });
      const menu = document.getElementById("menu")!;
      menu.addEventListener("click", () => {
        menu.setAttribute("aria-expanded", String(document.getElementById("nav")!.classList.toggle("open")));
      });
    </script>
  </body>
</html>
