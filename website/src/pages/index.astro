---
import Base from "../layouts/Base.astro";
import BenchChart from "../components/BenchChart.astro";
import CodeTabs from "../components/CodeTabs.astro";
import InstallBar from "../components/InstallBar.astro";
import { GITHUB, NPM, VERSION, url } from "../data/site";

const quickStart = [
  {
    name: "basic.js",
    code: `import init, { Workbook } from "@kuramajs/excel";

await init();
const wb = Workbook.open(await file.arrayBuffer());

wb.sheet("Orders").toObjects();
// [{ id: 1, customer: "Ann", shipped: Date, total: 125.5 }, …]`,
  },
  {
    name: "stream.js",
    code: `// a million rows, low memory
for (const row of wb.iterRows("Orders")) {
  if (row[3] > 1000) bigOrders.push(row);
}

// or the fastest path
wb.forEachRow("Orders", (row, i) => { /* … */ });`,
  },
  {
    name: "progress.js",
    code: `const sheet = wb.sheet("Orders", {
  onProgress: (read, total) => (bar.value = read / total),
});

sheet.rowsSlice(0, 100); // first page`,
  },
];

const features = [
  { ref: "A1", ico: "⇣", title: "Streaming rows", text: "Generator or callback. Visit a million rows without building them all in memory." },
  { ref: "B1", ico: "%", title: "Progress callbacks", text: "onProgress(rowsRead, total) for progress bars on big files." },
  { ref: "C1", ico: "T", title: "Typed cells", text: "Numbers stay numbers. Dates become UTC Dates. Errors are values, not crashes." },
  { ref: "A2", ico: "{}", title: "TypeScript", text: "Exact types for every cell, option and error code." },
  { ref: "B2", ico: "⚙", title: "Workers-ready", text: "Parse off the main thread and keep your UI smooth." },
  { ref: "C2", ico: "!", title: "Clear errors", text: "PASSWORD_PROTECTED, SHEET_NOT_FOUND and more, as error codes." },
];
---

<Base
  title="@kuramajs/excel: fast Excel reader for JavaScript & WebAssembly"
  description="Read xlsx, xlsm, xlsb, xls, ods and csv files in the browser or Node.js using little memory. Typed cells, streaming rows and progress callbacks. Rust + WebAssembly."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "@kuramajs/excel",
    description: "Fast, low-memory Excel reader for browsers and Node.js, in Rust + WebAssembly.",
    codeRepository: GITHUB,
    programmingLanguage: ["Rust", "TypeScript", "JavaScript"],
    runtimePlatform: ["Browser", "Node.js", "WebAssembly"],
    license: "https://opensource.org/licenses/MIT",
    version: VERSION,
    url: NPM,
    keywords: "excel, xlsx, xls, xlsb, ods, csv, spreadsheet, parser, reader, webassembly, rust, streaming",
  }}
>
  <section class="hero gridbg">
    <div class="colheads" aria-hidden="true">
      <span></span>{["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K"].map((c) => <span class:list={{ sel: c === "B" }}>{c}</span>)}
    </div>
    <div class="rownums" aria-hidden="true">{Array.from({ length: 20 }, (_, i) => <span>{i + 1}</span>)}</div>
    <div class="wrap inner">
      <div class="body">
        <div>
          <div class="eyebrow">Rust + WebAssembly · read-only</div>
          <h1>Read huge Excel files with <em>10× less memory</em>.</h1>
          <p class="lede">
            Read a million-row spreadsheet in about 3 seconds, using under 300 MB. Typed cells, streaming rows and progress
            callbacks, in the browser or Node.
          </p>
          <div class="ctas">
            <a class="btn primary" href={url("/playground")}>Open the playground →</a>
            <a class="btn ghost" href={url("/docs")}>Read the docs</a>
          </div>
          <InstallBar />
        </div>
        <div class="sheet" aria-label="Example spreadsheet">
          <div class="titlebar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp; orders.xlsx · 1,048,576 rows</div>
          <table>
            <thead><tr><th></th><th>A</th><th>B</th><th>C</th><th>D</th></tr></thead>
            <tbody>
              <tr><th>1</th><td><b>id</b></td><td><b>customer</b></td><td><b>shipped</b></td><td><b>total</b></td></tr>
              <tr><th>2</th><td class="n">1</td><td>Ann Perera</td><td class="d">2024-01-02</td><td class="n">125.50</td></tr>
              <tr><th>3</th><td class="n">2</td><td>Kumar S.</td><td class="d">2024-01-03</td><td class="n">89.00</td></tr>
              <tr><th>4</th><td class="n">3</td><td>Mia Chen</td><td class="d">2024-01-03</td><td class="e">#DIV/0!</td></tr>
              <tr><th>5</th><td class="n">4</td><td>Leo Fernando</td><td class="d">2024-01-04</td><td class="n hl">412.75</td></tr>
              <tr><th>6</th><td class="n">5</td><td>Sara Ali</td><td class="d">2024-01-05</td><td class="n">63.20</td></tr>
              <tr><th>7</th><td colspan="4" style="color:var(--faint); text-align:center">⋮ 1,048,570 more rows streamed in 3.4 s</td></tr>
            </tbody>
          </table>
          <div class="tabs"><span class="on">Orders</span><span>Customers</span><span>Q1</span><span>+</span></div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="stats">
      <div><span class="ref">A1</span><b>10×</b><span>less memory (282 MB vs 2.9 GB)</span></div>
      <div><span class="ref">B1</span><b>3.5×</b><span>faster than SheetJS on a 1M-row file</span></div>
      <div><span class="ref">C1</span><b>6</b><span>formats: xlsx · xlsm · xlsb · xls · ods · csv</span></div>
      <div><span class="ref">D1</span><b>0</b><span>JavaScript dependencies</span></div>
    </div>
    <div class="formats">
      <span>Reads</span>
      <div class="ftabs"><span>.xlsx</span><span>.xlsm</span><span>.xlsb</span><span>.xls</span><span>.ods</span><span>.csv</span></div>
      <span>Runs in</span>
      <div class="runs">
        <span class="badge"><b>Browsers</b></span><span class="badge"><b>Web Workers</b></span><span class="badge"><b>Node.js 20+</b></span><span class="badge"><b>ESM + CJS</b></span>
      </div>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="eyebrow">Benchmarks</div>
      <h2>Built for files other libraries choke on.</h2>
      <p class="sub">Generated sheets with 8 columns of mixed types, read with Node 22. Reproduce it yourself in Node, or right here in your browser.</p>
      <BenchChart compact>
        <div class="spacer"></div>
        <a class="btn ghost sm" href={url("/benchmarks")}>Full results →</a>
      </BenchChart>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap two">
      <div>
        <div class="eyebrow">Quick start</div>
        <h2>Three lines to your first row.</h2>
        <p class="sub">
          The same code runs in browsers, Web Workers and Node.js 20+. Cells come back as real JavaScript values: numbers,
          booleans, <code class="mono">Date</code>s, <code class="mono">null</code>, and <code class="mono">{"{ error }"}</code>.
        </p>
        <a class="btn ghost" href={url("/docs#api")}>API reference →</a>
      </div>
      <CodeTabs files={quickStart} />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="eyebrow">Features</div>
      <h2>Everything you need to read a spreadsheet.</h2>
      <p class="sub">Nothing you don't: no writing, no styles, no formula engine. Just fast, correct values.</p>
      <div class="cells">
        {
          features.map((f) => (
            <div>
              <span class="ref">{f.ref}</span>
              <div class="ico" aria-hidden="true">{f.ico}</div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
